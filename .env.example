# PostgreSQL
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
DATABASE_URL_SYNC=postgresql://trading:trading@localhost:5432/trading

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# S3 / MinIO
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=trading-screenshots
STORAGE_REGION=us-east-1

# Market data provider (Twelvedata, Polygon, etc.)
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_KEY=

# AI
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Frontend
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
